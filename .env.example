# Copy to .env and fill in (Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" key: safe to send to the browser
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET service-role key: server only, NEVER expose or commit this
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Bakery settings
BAKERY_TIMEZONE=Asia/Manila
BAKERY_OPEN_HOUR=7
BAKERY_CLOSE_HOUR=19

# Server
PORT=5000
FLASK_DEBUG=0
# Comma-separated origins allowed to call /api (the app serves its own frontend, so * is fine)
CORS_ORIGINS=*
